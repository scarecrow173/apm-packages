{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APM Semantic Dependency Graph",
  "type": "object",
  "required": [
    "nodes",
    "edges",
    "coverage"
  ],
  "properties": {
    "coverage": {
      "type": "object",
      "properties": {
        "package_dependency_graph": {
          "type": "string"
        },
        "component_provenance_graph": {
          "type": "string"
        },
        "semantic_interaction_graph": {
          "type": "string"
        },
        "capability_exposure_graph": {
          "type": "string"
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "package": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "local",
              "direct-dependency",
              "transitive-dependency",
              "generated",
              "external",
              "unknown"
            ]
          },
          "depth": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type",
          "reason"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "package_nodes": {
          "type": "integer"
        },
        "component_nodes": {
          "type": "integer"
        },
        "capability_nodes": {
          "type": "integer"
        },
        "edge_count": {
          "type": "integer"
        },
        "highest_dependency_depth": {
          "type": [
            "integer",
            "null"
          ]
        },
        "highest_risk_edge": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
