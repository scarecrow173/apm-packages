{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APM Semantic Package Evaluation Report",
  "type": "object",
  "required": [
    "package",
    "summary",
    "coverage",
    "package_scores",
    "cross_component_findings",
    "recommendation"
  ],
  "properties": {
    "package": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "score",
        "grade",
        "recommendation",
        "confidence",
        "evaluation_mode"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 160
        },
        "grade": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "F"
          ]
        },
        "recommendation": {
          "type": "string"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evaluation_mode": {
          "type": "string"
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "count",
          "reviewer",
          "average_score"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "reviewer": {
            "type": "string"
          },
          "average_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "worst_finding": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "package_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "score",
          "max",
          "evidence"
        ],
        "properties": {
          "dimension": {
            "type": "string"
          },
          "score": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "cross_component_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "title",
          "evidence",
          "impact",
          "fix"
        ],
        "properties": {
          "severity": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": [
        "action",
        "rationale",
        "top_fixes"
      ],
      "properties": {
        "action": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "top_fixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "graph_summary": {
      "type": "object",
      "properties": {
        "graph_built": {
          "type": "string",
          "enum": [
            "yes",
            "partial",
            "no",
            "unknown"
          ]
        },
        "package_nodes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "component_nodes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "capability_nodes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "highest_dependency_depth": {
          "type": [
            "integer",
            "null"
          ]
        },
        "most_important_finding": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      },
      "additionalProperties": true
    },
    "dependency_graph_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "title",
          "evidence",
          "synthesis_impact"
        ],
        "properties": {
          "severity": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "synthesis_impact": {
            "type": "string"
          },
          "fix": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
