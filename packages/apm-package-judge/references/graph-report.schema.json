{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dependency Graph Semantic Review Report",
  "type": "object",
  "required": [
    "summary",
    "graph_metrics",
    "findings",
    "cap_recommendations"
  ],
  "properties": {
    "summary": {
      "type": "object",
      "required": [
        "score",
        "grade",
        "verdict",
        "confidence"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "grade": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "F"
          ]
        },
        "verdict": {
          "type": "string"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      },
      "additionalProperties": true
    },
    "graph_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "view",
          "status"
        ],
        "properties": {
          "view": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "unknowns": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "graph_metrics": {
      "type": "object",
      "properties": {
        "package_nodes": {
          "type": "integer"
        },
        "component_nodes": {
          "type": "integer"
        },
        "capability_nodes": {
          "type": "integer"
        },
        "edge_count": {
          "type": "integer"
        },
        "highest_dependency_depth": {
          "type": [
            "integer",
            "null"
          ]
        },
        "highest_risk_edge": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "title",
          "evidence",
          "synthesis_impact",
          "fix"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "title": {
            "type": "string"
          },
          "edge_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "string"
          },
          "synthesis_impact": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "cap_recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "condition",
          "package_score_impact",
          "reason"
        ],
        "properties": {
          "condition": {
            "type": "string"
          },
          "package_score_impact": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "mermaid": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
