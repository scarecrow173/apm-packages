{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "adapter_id": {
      "type": "string"
    },
    "schema_validation": {
      "type": "object",
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "field",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "result",
        "errors"
      ],
      "additionalProperties": false
    },
    "staleness_validation": {
      "type": "object",
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "skipped"
          ]
        },
        "basis": {
          "type": "string"
        },
        "basis_date": {
          "type": "string"
        },
        "max_age_days": {
          "type": "number"
        },
        "age_days": {
          "type": "number"
        },
        "new_skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed_skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "result",
        "basis",
        "basis_date",
        "max_age_days",
        "age_days",
        "new_skills",
        "removed_skills"
      ],
      "additionalProperties": false
    },
    "deterministic_validation": {
      "type": "object",
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "skipped"
          ]
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string"
              },
              "diff_found": {
                "type": "boolean"
              }
            },
            "required": [
              "target",
              "diff_found"
            ],
            "additionalProperties": false
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "result",
        "comparisons"
      ],
      "additionalProperties": false
    },
    "blocking_validations": {
      "type": "object",
      "properties": {
        "result": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "result": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "skipped"
                ]
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "type",
              "result",
              "details"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "result",
        "checks"
      ],
      "additionalProperties": false
    },
    "catalog_validation": {
      "type": "object",
      "properties": {
        "skill_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reference_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capability_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "orphan_skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "skill_count",
        "reference_count",
        "capability_count",
        "orphan_skills"
      ],
      "additionalProperties": false
    },
    "profile_validation": {
      "type": "object",
      "properties": {
        "flow_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "flow_stack_slot_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unresolved_slots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolved_invocation_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unused_override_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "flow_count",
        "flow_stack_slot_count",
        "unresolved_slots",
        "resolved_invocation_count",
        "unused_override_warnings"
      ],
      "additionalProperties": false
    },
    "overall_result": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "repository",
    "adapter_id",
    "schema_validation",
    "staleness_validation",
    "deterministic_validation",
    "blocking_validations",
    "catalog_validation",
    "profile_validation",
    "overall_result"
  ],
  "additionalProperties": false
}
