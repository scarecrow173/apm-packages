{
  "globs": [
    "**/*.md",
    "!node_modules/**"
  ],
  // `apm install` materializes the pinned upstream tree under apm_modules/,
  // and `scripts/pstack-devin` generates devin-plugin/ the same way. Both are
  // vendored/generated bytes, not authored documentation, so they are never
  // linted. build/ holds the builder's transient staging/fetch dirs — it
  // contains upstream bytes mid-materialization and can linger after a
  // crashed run, so it is ignored for the same reason.
  // The ignore is resolved relative to the invocation cwd, so it must be anchored with `**/`.
  "ignores": [
    "**/apm_modules/**",
    "**/build/**",
    "**/devin-plugin/**"
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD025": false,
    "MD033": false
  }
}
