{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "skill_path": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "body",
          "skill_path",
          "scope"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "skills"
  ],
  "additionalProperties": false
}
