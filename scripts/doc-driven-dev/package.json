{
  "name": "doc-driven-dev-build",
  "version": "0.1.0",
  "private": true,
  "description": "Build environment for doc-driven-dev skill scripts",
  "scripts": {
    "build": "pnpm run build:scripts && pnpm run build:schemas",
    "build:scripts": "tsx build/build-skill-scripts.ts",
    "build:schemas": "tsx build/generate-json-schemas.ts",
    "test": "tsx --test tests/*.test.ts tests/**/*.test.ts",
    "lint:md": "markdownlint-cli2"
  },
  "packageManager": "pnpm@11.2.2",
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.11",
    "markdownlint-cli2": "^0.22.1",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3"
  }
}
