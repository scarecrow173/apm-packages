{
  "name": "pstack-devin-build",
  "version": "0.1.0",
  "private": true,
  "description": "Build and contract-test environment for the pstack-devin APM package",
  "scripts": {
    "build": "tsx src/cli.ts build",
    "check-generated": "tsx src/cli.ts check",
    "audit:compat": "tsx src/compat-audit.ts",
    "check:links": "tsx src/link-check.ts",
    "check:safety": "tsx src/safety-scan.ts",
    "check:roles": "tsx src/role-registry.ts",
    "probe:consumer": "tsx src/l3-consumer.ts",
    "probe:fixture": "node scripts/make-fixture.mjs",
    "check:marketplace": "tsx src/check-marketplace.ts",
    "check:upstream": "tsx src/check-upstream.ts",
    "report:update": "tsx src/update-report.ts",
    "apply:update": "tsx src/apply-update.ts",
    "verify:l1": "pnpm run check-generated && tsx src/safety-scan.ts",
    "verify:l2": "tsx src/compat-audit.ts && tsx src/link-check.ts && tsx src/role-registry.ts",
    "verify:l3": "tsx src/l3-dist.ts && tsx src/check-marketplace.ts",
    "verify": "pnpm run verify:l1 && pnpm run verify:l2 && pnpm run verify:l3 && pnpm test",
    "test": "tsx --test tests/*.test.ts",
    "lint:md": "markdownlint-cli2 --no-globs --config ../../packages/pstack-devin/.markdownlint-cli2.jsonc \"../../packages/pstack-devin/**/*.md\""
  },
  "packageManager": "pnpm@11.2.2",
  "dependencies": {
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "markdownlint-cli2": "^0.24.1",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3"
  }
}
