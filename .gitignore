# shared ignore rules for package and script workspaces
**/apm_modules/
**/node_modules/
**/dist/
**/__pycache__/
**/*.pyc

# keep build ignores split because scripts/**/build is tracked source
packages/**/build/
/build/

# apm install generated deployment outputs (root consumer mode)
/.agents/*
!/.agents/plugins/
/.claude/
/.codex/
/.cursor/
/.github/agents/
/.github/instructions/
/.github/skills/
/.vscode/
/.mcp.json

.pnpm-store/

**/.sdp/


# APM dependencies
apm_modules/
